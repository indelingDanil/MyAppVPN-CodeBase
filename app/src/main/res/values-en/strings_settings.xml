    <!-- Hotspot sharing guide -->
    <string name="hotspot_title">VPN sharing</string>
    <string name="hotspot_cd_back">Back</string>
    <string name="hotspot_back">Back</string>
    <string name="hotspot_host_hint_unknown">IP from the block above</string>
    <string name="hotspot_status_connect_first">Connect the VPN first</string>
    <string name="hotspot_status_on_but_disabled">Sharing is active but turned off in Settings — it will stop after reconnecting</string>
    <string name="hotspot_status_working">Sharing is active</string>
    <string name="hotspot_status_enable_in_settings">Turn on “Share via hotspot” in Settings and reconnect</string>
    <string name="hotspot_status_no_hotspot">Hotspot not detected. Turn on the hotspot and reconnect the VPN</string>
    <string name="hotspot_params_title">Proxy settings</string>
    <string name="hotspot_http_proxy">HTTP proxy</string>
    <string name="hotspot_socks5">SOCKS5</string>
    <string name="hotspot_auth_note">The HTTP proxy has no password. The login and password are only needed for SOCKS5.</string>
    <string name="hotspot_login">Login</string>
    <string name="hotspot_password">Password</string>
    <string name="hotspot_new_password_pending">The new password applies after reconnecting the VPN.</string>
    <string name="hotspot_change_password">Change password</string>
    <string name="hotspot_password_change_note">A password change applies after reconnecting the VPN.</string>
    <string name="hotspot_copied">Copied: %1$s</string>
    <string name="hotspot_cd_copy">Copy: %1$s</string>
    <string name="hotspot_cd_show_password">Show password</string>
    <string name="hotspot_cd_hide_password">Hide password</string>
    <string name="hotspot_before_title">Before you start</string>
    <string name="hotspot_before_step1">Turn on “Share via hotspot” in Settings</string>
    <string name="hotspot_before_step2">Turn on the hotspot on this phone</string>
    <string name="hotspot_before_step3">Connect the VPN (after turning on the hotspot)</string>
    <string name="hotspot_before_step4">Connect the other device to your hotspot</string>
    <string name="hotspot_step_save">Tap “Save”</string>
    <string name="hotspot_android_title">Android</string>
    <string name="hotspot_android_step1">Settings → Wi-Fi</string>
    <string name="hotspot_android_step2">Long-press your hotspot network → “Modify” (or the ⚙ icon)</string>
    <string name="hotspot_android_step3">Open “Advanced options”</string>
    <string name="hotspot_android_step4">Proxy → “Manual”</string>
    <string name="hotspot_android_step5">Host: %1$s, port: %2$d</string>
    <string name="hotspot_ios_title">iPhone / iPad</string>
    <string name="hotspot_ios_step1">Settings → Wi-Fi</string>
    <string name="hotspot_ios_step2">Tap (i) next to your hotspot network</string>
    <string name="hotspot_ios_step3">At the bottom: “Configure Proxy” → “Manual”</string>
    <string name="hotspot_ios_step4">Server: %1$s, port: %2$d</string>
    <string name="hotspot_ios_step5">Authentication — off</string>
    <string name="hotspot_desktop_title">Windows / macOS</string>
    <string name="hotspot_desktop_windows">Windows: Settings → Network &amp; Internet → Proxy → “Use a proxy server” → address %1$s, port %2$d → Save</string>
    <string name="hotspot_desktop_macos">macOS: System Settings → Wi-Fi → Details… → Proxies → “Web proxy (HTTP)” and “Secure web proxy (HTTPS)” → %1$s : %2$d → OK</string>
    <string name="hotspot_telegram_title">Telegram (SOCKS5)</string>
    <string name="hotspot_telegram_step1">Settings → Data and Storage → Proxy → Add Proxy</string>
    <string name="hotspot_telegram_step2">Type: SOCKS5</string>
    <string name="hotspot_telegram_step3">Server: %1$s, port: %2$d</string>
    <string name="hotspot_telegram_step4">Login: %1$s, password: from the block above</string>
    <string name="hotspot_telegram_step5">Save and enable the proxy</string>
    <string name="hotspot_notes_title">Important</string>
    <string name="hotspot_note_access">The proxy is available only to devices connected to your hotspot. It is protected by the hotspot password.</string>
    <string name="hotspot_note_not_all_traffic">Not all app traffic goes through the system proxy (some games and apps ignore it).</string>
    <string name="hotspot_note_ip_changed">If the hotspot IP changed (the hotspot was turned off), reconnect the VPN and update the settings on the other device.</string>
    <string name="hotspot_verify_title">Check</string>
    <string name="hotspot_verify_text">Open a browser on the other device and check your IP on 2ip.ru or whoer.net — it should match the VPN server\'s IP.</string>
    <string name="hotspot_disable_title">How to turn off</string>
    <string name="hotspot_disable_text">On the other device, repeat the steps above and set “Proxy” to “None” (iOS — “Off”).</string>
</resources>
