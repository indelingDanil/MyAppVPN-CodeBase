    <!-- Exit refusals (session stopped) -->
    <string name="openflux_status_busy">Демо-сервер перегружен — все 8 мест заняты. Попробуйте позже.</string>
    <string name="openflux_status_expired">Ваш пробный час (или 2 ГБ) на демо-сервере закончился. Чтобы продолжить — поднимите свой выход OpenFlux (инструкция по кнопке ниже) или пользуйтесь обычными серверами.</string>
    <string name="openflux_status_ended">Демо OpenFlux завершено. Поднимите свой выход — инструкция в репозитории.</string>
    <string name="openflux_status_quota">Демо-сервер исчерпал дневной лимит трафика. Попробуйте завтра.</string>
    <string name="openflux_status_badtoken">Неверный токен или адрес OpenFlux.</string>
    <string name="openflux_status_noclient">Нужно обновить приложение.</string>
    <string name="openflux_status_unsupported">По этому адресу не выход OpenFlux (Node.js). Проверьте адрес: старые PHP-выходы больше не поддерживаются.</string>
