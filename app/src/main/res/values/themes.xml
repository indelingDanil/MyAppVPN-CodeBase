<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. Light/dark window colours come from values(-night)/colors.xml; the app draws
         edge-to-edge (MainActivity.enableEdgeToEdge) so system bars are transparent. -->
    <style name="Theme.MyAppVPN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>
</resources>
